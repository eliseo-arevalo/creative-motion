# Copy to .env (git-ignored) or export in your shell. Never commit real values, never print them in logs or chat.
# Everything renders without keys: the audio pipeline falls back to a placeholder voice and synthetic SFX/music.

# Voice-over, option A: ElevenLabs (paid plan = commercial use; free plan = non-commercial + attribution).
ELEVENLABS_API_KEY=
# Required with ElevenLabs: pick a voice you are allowed to use for the video. No default on purpose.
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Voice-over, option B: Gemini TTS.
GEMINI_API_KEY=
# GEMINI_VOICE=Kore
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Optional: a system Chrome/Chromium for Remotion instead of the one it downloads.
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/google-chrome

# Optional: path to the Rhubarb binary when it is not in PATH (lip-sync for characters, see docs/RHUBARB.md).
# RHUBARB=/opt/rhubarb/rhubarb
